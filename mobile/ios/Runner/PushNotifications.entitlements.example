<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Merge into Runner.entitlements only after enabling Push Notifications in
       the Apple App ID/provisioning profile. Use development for Debug and
       production for Release through the APS_ENVIRONMENT Xcode build setting. -->
  <key>aps-environment</key><string>$(APS_ENVIRONMENT)</string>
</dict></plist>
