  PROCESSED
  FAILED
  IGNORED
}

enum ExternalProductMappingStatus {
  ACTIVE
  ARCHIVED
}

enum PricingPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StoreSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum CreditLedgerEntryType {
  TRIAL_GRANTED
  PLAN_GRANTED
  CREDIT_PACK_PURCHASED
  CREDIT_CONSUMED
  CREDIT_REFUNDED
  MANUAL_ADJUSTMENT
}

enum CreditLedgerChannel {
  SHOPIFY
  WOOCOMMERCE
  KIOSK
  PUBLIC_API
  ADMIN
  MOBILE
}

enum JewelleryType {
  RING
  BRACELET
  NECKLACE
  EARRING
