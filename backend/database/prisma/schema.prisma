model KioskDeviceConfiguration {
  id                        String                            @id @db.Uuid
  kioskDeviceId             String                            @unique @map("kiosk_device_id") @db.Uuid
  version                   Int                               @default(1)
  idleMode                  KioskIdleMode                     @default(STATIC) @map("idle_mode")
  slideDurationSeconds      Int                               @default(6) @map("slide_duration_seconds")
  title                     String?                           @db.VarChar(120)
  subtitle                  String?                           @db.VarChar(180)
  ctaLabel                  String                            @default("Start Try-On") @map("cta_label") @db.VarChar(40)
  countdownSeconds          Int                               @default(5) @map("countdown_seconds")
  soundEnabled              Boolean                           @default(true) @map("sound_enabled")
  soundProfile              KioskConfigurationSoundProfile    @default(SELFX_SIGNATURE) @map("sound_profile")
  guidanceAudioEnabled      Boolean                           @default(false) @map("guidance_audio_enabled")
  enabledGarmentIntents     KioskConfigurationGarmentIntent[] @default([TOP, BOTTOM, FULL_OUTFIT]) @map("enabled_garment_intents")
  multiGarmentSelectionEnabled Boolean                         @default(true) @map("multi_garment_selection_enabled")
  maxTryOnPicks             Int                               @default(5) @map("max_try_on_picks")
  sessionIdleTimeoutSeconds Int                               @default(120) @map("session_idle_timeout_seconds")
  updatedByUserId           String?                           @map("updated_by_user_id") @db.Uuid
  createdAt                 DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)
