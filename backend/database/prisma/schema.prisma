enum OrganizationApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum ActivationRequirementStatus {
  PENDING
  SATISFIED
  WAIVED
}

model User {
  id                            String                              @id @db.Uuid
  email                         String                              @unique @db.VarChar(320)
  passwordHash                  String?                             @map("password_hash")
  credentialsVersion            Int                                 @default(0) @map("credentials_version")
  passwordChangedAt             DateTime?                           @map("password_changed_at") @db.Timestamptz(3)
  displayName                   String?                             @map("display_name") @db.VarChar(160)
  status                        UserStatus                          @default(ACTIVE)
  deletedAt                     DateTime?                           @map("deleted_at") @db.Timestamptz(3)
  emailVerifiedAt               DateTime?                           @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt                   DateTime?                           @map("last_login_at") @db.Timestamptz(3)
  createdAt                     DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditLogs                     AuditLog[]                          @relation("AuditActor")
  platformPaymentTests          PlatformPaymentTest[]
  applicationsReviewed          OrganizationApplication[]           @relation("OrganizationApplicationReviewedBy")
  applicationsSubmitted         OrganizationApplication[]           @relation("OrganizationApplicationSubmittedBy")
  memberships                   OrganizationMembership[]
  platformRoleAssignments       PlatformRoleAssignment[]            @relation("PlatformRoleAssignedToUser")
  platformRolesAssigned         PlatformRoleAssignment[]            @relation("PlatformRoleAssignedByUser")
  platformAccessRoleAssignments PlatformUserAccessRole[]            @relation("PlatformUserAccessRoleAssignedToUser")
  platformAccessRolesAssigned   PlatformUserAccessRole[]            @relation("PlatformUserAccessRoleAssignedByUser")
  impersonationSessions         ImpersonationSession[]              @relation("ImpersonationSessionActor")
  requirementsReviewed          OrganizationActivationRequirement[] @relation("ActivationRequirementReviewedBy")
  storeMembershipRolesAssigned  StoreMembershipRole[]               @relation("StoreMembershipRoleAssignedBy")
  storePermissionGrantsAssigned StorePermissionGrant[]              @relation("StorePermissionGrantGrantedByUser")
  sessions                      UserSession[]
  externalIdentities            UserExternalIdentity[]
  googleLinkRequests            UserOAuthRequest[]
  passwordResetTokens           PasswordResetToken[]
  kioskPairingClaims            KioskPairingSession[]               @relation("KioskPairingClaimedBy")
  kioskConfigurationsUpdated    KioskDeviceConfiguration[]          @relation("KioskConfigurationUpdatedBy")
  apiKeysCreated                ApiKey[]                            @relation("ApiKeyCreatedByUser")
  integrationsCreated           Integration[]                       @relation("IntegrationCreatedByUser")
  integrationCredentialsCreated IntegrationCredential[]             @relation("IntegrationCredentialCreatedByUser")
  integrationOauthStatesCreated IntegrationOauthState[]             @relation("IntegrationOauthStateCreatedByUser")
  shopifyLinkSessionsApproved   ShopifyLinkSession[]                @relation("ShopifyLinkSessionApprovedByUser")
  wooCommerceLinksApproved      WooCommerceLinkSession[]            @relation("WooCommerceLinkSessionApprovedByUser")

  regionalTimezone   String?      @map("regional_timezone") @db.VarChar(64)
  regionalDateFormat String       @default("AUTO") @map("regional_date_format") @db.VarChar(16)
  regionalTimeFormat String       @default("AUTO") @map("regional_time_format") @db.VarChar(8)
  appReleases        AppRelease[]

  @@map("users")
}

enum AppReleaseStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model AppRelease {
  id           String           @id @db.Uuid
  packageName  String           @map("package_name") @db.VarChar(160)
  versionName  String           @map("version_name") @db.VarChar(120)
  versionCode  Int              @map("version_code")
  architecture String           @db.VarChar(32)
  minSdk       Int              @map("min_sdk")
  sizeBytes    Int              @map("size_bytes")
  sha256       String           @unique @db.Char(64)
  signerSha256 String           @map("signer_sha256") @db.Char(64)
  objectKey    String           @unique @map("object_key")
  filename     String           @db.VarChar(200)
  releaseNotes String           @default("") @map("release_notes") @db.VarChar(4000)
  status       AppReleaseStatus @default(DRAFT)
  recommended  Boolean          @default(false)
  revision     Int              @default(0)
  uploadedById String?          @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  publishedAt  DateTime?        @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([packageName, versionCode, architecture])
  @@index([status, createdAt, id])
  @@map("app_releases")
}

model UserExternalIdentity {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String   @db.VarChar(32)
  subject     String   @db.VarChar(255)
  emailAtLink String   @map("email_at_link") @db.VarChar(320)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("user_external_identities")
}

model UserOAuthRequest {
  id                     String    @id @db.Uuid
  stateHash              String    @unique @map("state_hash") @db.Char(64)
  browserHash            String    @map("browser_hash") @db.Char(64)
  nonce                  String    @db.VarChar(64)
  codeVerifier           String    @map("code_verifier") @db.VarChar(128)
  mode                   String    @db.VarChar(16)
  returnPath             String    @map("return_path") @db.VarChar(2048)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt             DateTime? @map("consumed_at") @db.Timestamptz(3)
  linkUserId             String?   @map("link_user_id") @db.Uuid
  linkSubject            String?   @map("link_subject") @db.VarChar(255)
  linkEmail              String?   @map("link_email") @db.VarChar(320)
  linkCredentialsVersion Int?      @map("link_credentials_version")
  linkedAt               DateTime? @map("linked_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  linkUser               User?     @relation(fields: [linkUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([linkUserId])
  @@map("user_oauth_requests")
}

model UserSession {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  credentialsVersion Int       @default(0) @map("credentials_version")
  refreshTokenHash   String    @map("refresh_token_hash")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(3)
  deviceLabel        String?   @map("device_label") @db.VarChar(160)
  userAgentJson      Json?     @map("user_agent_json")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash") @db.Char(64)
  credentialsVersion Int       @map("credentials_version")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Bounded, encrypted transactional email outbox. No plaintext email bodies/tokens.
model MailJob {
  id            String    @id @db.Uuid
  eventKey      String?   @unique @map("event_key") @db.Char(64)
  templateCode  String?   @map("template_code") @db.VarChar(64)
  recipientMask String?   @map("recipient_mask") @db.VarChar(320)
  kind          String    @db.VarChar(32)
  status        String    @default("PENDING") @db.VarChar(20)
  payload       Json?
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  failureCode   String?   @map("failure_code") @db.VarChar(80)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([expiresAt])
  @@map("mail_jobs")
}

model PasswordRecoveryRateBucket {
  key       String   @id @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("password_recovery_rate_buckets")
}

// Durable cleanup after a committed permanent Store deletion.
model DeletedStoreObject {
  storageKey  String   @id @map("storage_key") @db.VarChar(512)
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("deleted_store_objects")
}

model Organization {
  customerStoreQrs               CustomerStoreQr[]
  shopifyBillingAgreements       ShopifyBillingAgreement[]
  commerceTaxSettings            StoreTaxSettings?
  shoppingOrders                 ShoppingOrder[]
  paymentSettings                StorePaymentSettings?
  paymentConnections             StorePaymentConnection[]
  paymentGatewayTests            PlatformPaymentTest[]
  id                             String                              @id @db.Uuid
  name                           String                              @db.VarChar(200)
  slug                           String                              @unique @db.VarChar(120)
  status                         OrganizationStatus                  @default(PENDING_ACTIVATION)
  timezone                       String                              @default("UTC") @db.VarChar(64)
  settings                       Json?
  createdAt                      DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  activationRequirements         OrganizationActivationRequirement[]
  applications                   OrganizationApplication[]
  auditLogs                      AuditLog[]
  memberships                    OrganizationMembership[]
  roles                          StoreRole[]
  permissionGrants               StorePermissionGrant[]
  stores                         Store[]
  kioskDevices                   KioskDevice[]
  tryOnSessions                  TryOnSession[]
  tryOnAssets                    TryOnAsset[]
  tryOnLooks                     TryOnLook[]
  tryOnShareCapabilities         TryOnShareCapability[]
  apiKeys                        ApiKey[]
  webhookEndpoints               WebhookEndpoint[]
  webhookDeliveries              WebhookDelivery[]
  productCategories              ProductCategory[]
  products                       Product[]
  integrations                   Integration[]
  integrationCredentials         IntegrationCredential[]
  integrationEvents              IntegrationEvent[]
  externalProductMappings        ExternalProductMapping[]
  integrationOauthStates         IntegrationOauthState[]
  shopifyLinkSessions            ShopifyLinkSession[]
  wooCommerceLinkSessions        WooCommerceLinkSession[]
  shopifyStorefrontTryOnSessions ShopifyStorefrontTryOnSession[]
  providerCredentials            IntegrationProviderCredential[]
  storeSubscription              StoreSubscription?
  creditLedgerEntries            CreditLedgerEntry[]
  billingCycles                  StoreBillingCycle[]
  billableGenerations            BillableGeneration[]
  impersonationSessions          ImpersonationSession[]              @relation("ImpersonationSessionTargetStore")

  @@index([status])
  @@map("organizations")
}

model ImpersonationSession {
  id            String                     @id @db.Uuid
  actorUserId   String?                    @map("actor_user_id") @db.Uuid
  actorSnapshot Json?                      @map("actor_snapshot")
  targetStoreId String                     @map("target_store_id") @db.Uuid
  status        ImpersonationSessionStatus @default(ACTIVE)
  startedAt     DateTime                   @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt     DateTime                   @map("expires_at") @db.Timestamptz(3)
  endedAt       DateTime?                  @map("ended_at") @db.Timestamptz(3)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
