generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum CustomerIdentityProvider {
  EMAIL_PASSWORD
  GOOGLE
  APPLE
  FIREBASE_PHONE
}

enum CustomerActionPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  APPLE_NONCE
  EMAIL_LOGIN
}

model Customer {
  profilePhotos         CustomerProfilePhoto[]
  pushDevices           CustomerPushDevice[]
  notificationsInbox    CustomerNotification[]
  id                    String                 @id @db.Uuid
  email                 String?                @unique @db.VarChar(320)
  phoneNumber           String?                @unique @map("phone_number") @db.VarChar(16)
  pendingPhoneNumber    String?                @map("pending_phone_number") @db.VarChar(16)
  phoneVerifiedAt       DateTime?              @map("phone_verified_at") @db.Timestamptz(3)
  phoneConsentAt        DateTime?              @map("phone_consent_at") @db.Timestamptz(3)
  displayName           String                 @map("display_name") @db.VarChar(160)
  status                CustomerStatus         @default(PENDING_VERIFICATION)
  securityVersion       Int                    @default(0) @map("security_version")
  verificationProofHash String?                @map("verification_proof_hash") @db.Char(64)
  termsVersion          String                 @map("terms_version") @db.VarChar(40)
  termsAcceptedAt       DateTime               @map("terms_accepted_at") @db.Timestamptz(3)
  language              String                 @default("en") @db.VarChar(12)
  notifications         Boolean                @default(false)
  interests             String[]               @default([])
  avatarSetupCompletedAt DateTime?              @map("avatar_setup_completed_at") @db.Timestamptz(3)
  lastActiveAt          DateTime?              @map("last_active_at") @db.Timestamptz(3)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  identities            CustomerIdentity[]
  sessions              CustomerSession[]
  actionTokens          CustomerActionToken[]
  creditAccount         CustomerCreditAccount?
  photoConsents         CustomerPhotoConsent[]
  tryOnSessions         TryOnSession[]
  tryOnRuns             KioskTryOnRun[]
  storeVisits           CustomerStoreVisit[]

  @@index([pendingPhoneNumber])
  @@map("customers")
}

model CustomerProfilePhoto {
  id               String   @id @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  storageKey       String   @unique @map("storage_key") @db.VarChar(512)
  kind             String   @default("PROFILE") @db.VarChar(16)
  consentVersion   String   @map("consent_version") @db.VarChar(40)
  consentStatement String   @map("consent_statement")
  consentLanguage  String   @map("consent_language") @db.VarChar(12)
  readyAt          DateTime? @map("ready_at") @db.Timestamptz(3)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  storageDeletedAt DateTime? @map("storage_deleted_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@index([customerId, kind, createdAt])
  @@index([storageDeletedAt, expiresAt])
  @@map("customer_profile_photos")
}

model CustomerIdentity {
  id              String                   @id @db.Uuid
  customerId      String                   @map("customer_id") @db.Uuid
  provider        CustomerIdentityProvider
  providerSubject String                   @map("provider_subject") @db.VarChar(320)
  email           String?                  @db.VarChar(320)
  passwordHash    String?                  @map("password_hash")
  verifiedAt      DateTime?                @map("verified_at") @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([customerId, provider])
  @@index([customerId])
  @@map("customer_identities")
}

model CustomerSession {
  pushDevices CustomerPushDevice[]
  id          String               @id @db.Uuid
  customerId  String               @map("customer_id") @db.Uuid
  familyId    String               @map("family_id") @db.Uuid
  tokenHash   String               @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?            @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt  DateTime?            @map("last_used_at") @db.Timestamptz(3)
  deviceName  String?              @map("device_name") @db.VarChar(100)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  authenticatedAt DateTime         @default(now()) @map("authenticated_at") @db.Timestamptz(3)
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model CustomerPushDevice {
  id             String                 @id @db.Uuid
  customerId     String                 @map("customer_id") @db.Uuid
  sessionId      String                 @map("session_id") @db.Uuid
  installationId String                 @map("installation_id") @db.Uuid
  tokenHash      String                 @unique @map("token_hash") @db.Char(64)
  tokenCipher    Json                   @map("token_cipher")
  platform       String                 @db.VarChar(16)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session        CustomerSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deliveries     CustomerPushDelivery[]

  @@unique([customerId, installationId])
  @@index([sessionId])
  @@map("customer_push_devices")
}

model CustomerNotification {
  id         String                 @id @db.Uuid
  customerId String                 @map("customer_id") @db.Uuid
  runId      String                 @map("run_id") @db.Uuid
  kind       String                 @db.VarChar(40)
  readAt     DateTime?              @map("read_at") @db.Timestamptz(3)
  expiresAt  DateTime               @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveries CustomerPushDelivery[]

  @@unique([customerId, runId, kind])
  @@index([customerId, createdAt, id])
  @@map("customer_notifications")
}

model CustomerPushDelivery {
  id             String               @id @db.Uuid
  notificationId String               @map("notification_id") @db.Uuid
  deviceId       String               @map("device_id") @db.Uuid
  state          String               @default("PENDING") @db.VarChar(20)
  attempts       Int                  @default(0)
  availableAt    DateTime             @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseUntil     DateTime?            @map("lease_until") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  notification   CustomerNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device         CustomerPushDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([notificationId, deviceId])
  @@index([state, availableAt])
  @@map("customer_push_deliveries")
}

model CustomerActionToken {
  id              String                @id @db.Uuid
  customerId      String?               @map("customer_id") @db.Uuid
  purpose         CustomerActionPurpose
  tokenHash       String                @unique @map("token_hash") @db.Char(64)
  securityVersion Int                   @default(0) @map("security_version")
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime?             @map("used_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  customer        Customer?             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
  @@index([expiresAt])
  @@map("customer_action_tokens")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

