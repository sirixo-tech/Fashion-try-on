  createdByUser     User?                       @relation("IntegrationCredentialCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([integrationId])
  @@index([organizationId, status])
  @@index([tokenPrefix])
  @@index([createdByUserId])
  @@map("integration_credentials")
}

model IntegrationEvent {
  id              String                 @id @db.Uuid
  integrationId   String                 @map("integration_id") @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  externalEventId String                 @map("external_event_id") @db.VarChar(220)
  eventType       String                 @map("event_type") @db.VarChar(120)
  status          IntegrationEventStatus @default(RECEIVED)
  payload         Json?                  @map("payload_json")
  processedAt     DateTime?              @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  integration     Integration            @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([integrationId, externalEventId])
  @@index([organizationId, createdAt])
  @@index([integrationId, status, createdAt])
  @@index([eventType, createdAt])
  @@map("integration_events")
}

model ExternalProductMapping {
  id                String                       @id @db.Uuid
  integrationId     String                       @map("integration_id") @db.Uuid
  organizationId    String                       @map("organization_id") @db.Uuid
  productId         String                       @map("product_id") @db.Uuid
  externalProductId String                       @map("external_product_id") @db.VarChar(180)
  externalVariantId String?                      @map("external_variant_id") @db.VarChar(180)
  externalSku       String?                      @map("external_sku") @db.VarChar(120)
  externalHandle    String?                      @map("external_handle") @db.VarChar(220)
  status            ExternalProductMappingStatus @default(ACTIVE)
  metadata          Json?                        @map("metadata_json")
  externalUpdatedAt DateTime?                    @map("external_updated_at") @db.Timestamptz(3)
  lastSeenAt        DateTime                     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  integration       Integration                  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product           Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([integrationId])
  @@index([organizationId, status])
  @@index([productId])
  @@index([integrationId, externalProductId])
  @@index([integrationId, externalSku])
  @@index([integrationId, lastSeenAt])
  @@map("external_product_mappings")
}

model TryOnShareCapability {
  id               String               @id @db.Uuid
  sessionId        String               @map("try_on_session_id") @db.Uuid
  capabilityDigest String               @unique @map("capability_digest")
  assignmentScope  KioskAssignmentScope @map("assignment_scope")
  organizationId   String?              @map("organization_id") @db.Uuid
  storeId          String?              @map("store_id") @db.Uuid
  kioskDeviceId    String?              @map("kiosk_device_id") @db.Uuid
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  session          TryOnSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store            Store?               @relation(fields: [organizationId, storeId], references: [orgId, id], onDelete: Restrict)
  kioskDevice      KioskDevice?         @relation(fields: [kioskDeviceId], references: [id], onDelete: SetNull)

  @@index([sessionId, expiresAt])
  @@index([kioskDeviceId, expiresAt])
  @@index([organizationId, expiresAt])
  @@index([storeId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("try_on_share_capabilities")
}

model UsageEvent {
  id              String                @id @db.Uuid
  idempotencyKey  String                @unique @map("idempotency_key") @db.VarChar(180)
  eventName       String                @map("event_name") @db.VarChar(80)
  channel         String                @db.VarChar(40)
  apiKeyId        String?               @map("api_key_id") @db.Uuid
  assignmentScope KioskAssignmentScope? @map("assignment_scope")
  organizationId  String?               @map("organization_id") @db.Uuid
  storeId         String?               @map("store_id") @db.Uuid
  kioskDeviceId   String?               @map("kiosk_device_id") @db.Uuid
  tryOnSessionId  String?               @map("try_on_session_id") @db.Uuid
  kioskTryOnRunId String?               @map("kiosk_try_on_run_id") @db.Uuid
  tryOnLookId     String?               @map("try_on_look_id") @db.Uuid
  productId       String?               @map("product_id") @db.Uuid
  provider        String?               @db.VarChar(80)
  providerModel   String?               @map("provider_model") @db.VarChar(120)
  status          String?               @db.VarChar(80)
  quantity        Int                   @default(1)
  metadata        Json?                 @map("metadata_json")
  occurredAt      DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  apiKey          ApiKey?               @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([eventName, occurredAt])
  @@index([channel, occurredAt])
  @@index([apiKeyId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([storeId, occurredAt])
  @@index([kioskDeviceId, occurredAt])
  @@index([tryOnSessionId, occurredAt])
  @@index([kioskTryOnRunId])
  @@index([tryOnLookId])
  @@index([productId, occurredAt])
  @@map("usage_events")
}

model PricingPlan {
  shopifyBillingAgreements ShopifyBillingAgreement[]
  id                       String                    @id @db.Uuid
  code                     String                    @unique @db.VarChar(80)
  name                     String                    @db.VarChar(160)
  status                   PricingPlanStatus         @default(ACTIVE)
  channels                 Json                      @map("channels_json")
  currency                 String                    @default("USD") @db.Char(3)
  billingMode              PlanBillingMode           @default(CREDIT_LIMITED) @map("billing_mode")
  creditUnitPriceCents     Int?                      @map("credit_unit_price_cents")
  monthlyPriceCents        Int                       @default(0) @map("monthly_price_cents")
  includedCredits          Int                       @default(0) @map("included_credits")
  trialCredits             Int                       @default(10) @map("trial_credits")
  storeLocationLimit       Int?                      @map("store_location_limit")
  extraCreditPriceCents    Int?                      @map("extra_credit_price_cents")
  kioskMonthlyRentCents    Int?                      @map("kiosk_monthly_rent_cents")
  kioskDeviceLimit         Int?                      @map("kiosk_device_limit")
  metadata                 Json?                     @map("metadata_json")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions            StoreSubscription[]
  creditLedgerEntries      CreditLedgerEntry[]
  rates                    PricingPlanRate[]

  @@index([status])
  @@map("pricing_plans")
}

model StoreSubscription {
  id                  String                  @id @db.Uuid
  organizationId      String                  @unique @map("organization_id") @db.Uuid
  pricingPlanId       String?                 @map("pricing_plan_id") @db.Uuid
  status              StoreSubscriptionStatus @default(TRIALING)
  channels            Json                    @map("channels_json")
  includedCredits     Int                     @default(0) @map("included_credits")
  trialCredits        Int                     @default(10) @map("trial_credits")
  currentPeriodStart  DateTime?               @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd    DateTime?               @map("current_period_end") @db.Timestamptz(3)
  trialStartedAt      DateTime?               @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt         DateTime?               @map("trial_ends_at") @db.Timestamptz(3)
  cancelledAt         DateTime?               @map("cancelled_at") @db.Timestamptz(3)
  billingAnchorAt     DateTime?               @map("billing_anchor_at") @db.Timestamptz(3)
  metadata            Json?                   @map("metadata_json")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pricingPlan         PricingPlan?            @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)
  creditLedgerEntries CreditLedgerEntry[]
  billingCycles       StoreBillingCycle[]

  @@unique([organizationId, id])
  @@index([status])
  @@index([pricingPlanId])
  @@index([currentPeriodEnd])
  @@map("store_subscriptions")
}

enum PlanBillingMode {
  CREDIT_LIMITED
  POSTPAID_PAYG
}

enum GenerationBillingCoverage {
  UNBILLED
  PREPAID
  POSTPAID
}

model PricingPlanRate {
  id                   String      @id @db.Uuid
  pricingPlanId        String      @map("pricing_plan_id") @db.Uuid
  currency             String      @db.Char(3)
  creditUnitPriceCents Int         @map("credit_unit_price_cents")
  effectiveAt          DateTime    @map("effective_at") @db.Timestamptz(3)
  pricingPlan          PricingPlan @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict)

  @@index([pricingPlanId, effectiveAt])
  @@map("pricing_plan_rates")
}

model StoreBillingCycle {
  id                   String               @id @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  subscriptionId       String               @map("subscription_id") @db.Uuid
  pricingPlanId        String               @map("pricing_plan_id") @db.Uuid
  periodStart          DateTime             @map("period_start") @db.Timestamptz(3)
  periodEnd            DateTime             @map("period_end") @db.Timestamptz(3)
  currency             String               @db.Char(3)
  creditUnitPriceCents Int                  @map("credit_unit_price_cents")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  subscription         StoreSubscription    @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  runs                 KioskTryOnRun[]
  generations          BillableGeneration[]

  @@unique([organizationId, id])
  @@unique([subscriptionId, periodStart])
  @@index([organizationId, periodEnd])
  @@map("store_billing_cycles")
}

// Financial provenance deliberately has no FK to temporary runs, looks or images.
model BillableGeneration {
  shopifyUsageCharge ShopifyUsageCharge?
  id                 String                    @id @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  runId              String                    @unique @map("run_id") @db.Uuid
  channel            CreditLedgerChannel?
  coverage           GenerationBillingCoverage @default(UNBILLED)
  billingCycleId     String?                   @map("billing_cycle_id") @db.Uuid
  completedAt        DateTime                  @map("completed_at") @db.Timestamptz(3)
  historical         Boolean                   @default(false)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  billingCycle       StoreBillingCycle?        @relation(fields: [organizationId, billingCycleId], references: [organizationId, id], onDelete: Restrict)
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, completedAt])
  @@index([billingCycleId, coverage])
  @@map("billable_generations")
}

model CreditLedgerEntry {
  id              String                @id @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  subscriptionId  String?               @map("subscription_id") @db.Uuid
  pricingPlanId   String?               @map("pricing_plan_id") @db.Uuid
  entryType       CreditLedgerEntryType @map("entry_type")
  channel         CreditLedgerChannel?
  quantity        Int
  balanceAfter    Int?                  @map("balance_after")
  idempotencyKey  String                @unique @map("idempotency_key") @db.VarChar(180)
  reason          String?               @db.VarChar(240)
  tryOnSessionId  String?               @map("try_on_session_id") @db.Uuid
  kioskTryOnRunId String?               @map("kiosk_try_on_run_id") @db.Uuid
  productId       String?               @map("product_id") @db.Uuid
  integrationId   String?               @map("integration_id") @db.Uuid
  metadata        Json?                 @map("metadata_json")
  occurredAt      DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription    StoreSubscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  pricingPlan     PricingPlan?          @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, channel, occurredAt])
  @@index([organizationId, entryType, occurredAt])
  @@index([subscriptionId, occurredAt])
  @@index([pricingPlanId])
  @@index([tryOnSessionId])
  @@index([kioskTryOnRunId])
  @@index([productId])
  @@index([integrationId])
  @@map("credit_ledger_entries")
}

model ApiKey {
  id                String               @id @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  name              String               @db.VarChar(120)
  keyPrefix         String               @map("key_prefix") @db.VarChar(40)
  secretHash        String               @map("secret_hash") @db.VarChar(128)
  environment       String               @db.VarChar(20)
  status            String               @default("ACTIVE") @db.VarChar(20)
  scopes            Json                 @map("scopes_json")
  expiresAt         DateTime?            @map("expires_at") @db.Timestamptz(3)
  lastUsedAt        DateTime?            @map("last_used_at") @db.Timestamptz(3)
  createdByUserId   String?              @map("created_by_user_id") @db.Uuid
  createdBySnapshot Json?                @map("created_by_snapshot")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz(3)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser     User?                @relation("ApiKeyCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tryOnRuns         KioskTryOnRun[]      @relation("ApiKeyTryOnRuns")
  usageEvents       UsageEvent[]
  rateLimitBuckets  ApiRateLimitBucket[]

  @@index([organizationId])
  @@index([keyPrefix])
  @@index([organizationId, status])
  @@map("api_keys")
}

model ApiRateLimitBucket {
  id             String   @id @db.Uuid
  apiKeyId       String   @map("api_key_id") @db.Uuid
  routeBucket    String   @map("route_bucket") @db.VarChar(80)
  windowSeconds  Int      @map("window_seconds")
  windowStartsAt DateTime @map("window_starts_at") @db.Timestamptz(3)
  requestCount   Int      @default(0) @map("request_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, routeBucket, windowSeconds, windowStartsAt])
  @@index([apiKeyId, routeBucket, windowStartsAt])
  @@index([windowStartsAt])
  @@map("api_rate_limit_buckets")
}

model WebhookEndpoint {
  id               String            @id @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  url              String            @db.VarChar(2048)
  status           String            @default("ACTIVE") @db.VarChar(20)
  secretReference  String            @default("derived:v1") @map("secret_reference") @db.VarChar(160)
  subscribedEvents Json              @map("subscribed_events_json")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deliveries       WebhookDelivery[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String          @id @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  webhookEndpointId String          @map("webhook_endpoint_id") @db.Uuid
  eventId           String          @map("event_id") @db.Uuid
  eventType         String          @map("event_type") @db.VarChar(80)
  payload           Json?           @map("payload_json")
  attemptNumber     Int             @default(1) @map("attempt_number")
  status            String          @default("PENDING") @db.VarChar(20)
  httpStatus        Int?            @map("http_status")
  errorMessage      String?         @map("error_message") @db.Text
  nextRetryAt       DateTime?       @map("next_retry_at") @db.Timestamptz(3)
  deliveredAt       DateTime?       @map("delivered_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@unique([webhookEndpointId, eventId, attemptNumber])
  @@index([organizationId, createdAt])
  @@index([webhookEndpointId, createdAt])
  @@index([eventId])
  @@index([eventType, createdAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model AuditLog {
  id             String        @id @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  storeId        String?       @map("store_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actorSnapshot  Json?         @map("actor_snapshot")
  action         String        @db.VarChar(160)
  resourceType   String        @map("resource_type") @db.VarChar(160)
  resourceId     String?       @map("resource_id") @db.Uuid
  requestId      String?       @map("request_id") @db.VarChar(120)
  metadata       Json?         @map("metadata_json")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser      User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  store          Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([storeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
  @@map("audit_logs")
}
