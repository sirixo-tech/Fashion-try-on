model TryOnSession {
  id                   String               @id @db.Uuid
  status               TryOnSessionStatus   @default(ACTIVE)
  assignmentScope      KioskAssignmentScope @map("assignment_scope")
  organizationId       String?              @map("organization_id") @db.Uuid
  storeId              String?              @map("store_id") @db.Uuid
  kioskDeviceId        String?              @map("kiosk_device_id") @db.Uuid
  currentPersonAssetId String?              @map("current_person_asset_id") @db.Uuid
  completedAt          DateTime?            @map("completed_at") @db.Timestamptz(3)
  expiresAt            DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store                Store?               @relation(fields: [organizationId, storeId], references: [orgId, id], onDelete: Restrict)
  kioskDevice          KioskDevice?         @relation(fields: [kioskDeviceId], references: [id], onDelete: SetNull)
  currentPersonAsset   TryOnAsset?          @relation("TryOnSessionCurrentPersonAsset", fields: [currentPersonAssetId], references: [id], onDelete: SetNull)
  assets               TryOnAsset[]         @relation("TryOnSessionAssets")
  runs                 KioskTryOnRun[]
  looks                TryOnLook[]
  shareCapabilities    TryOnShareCapability[]

  @@index([kioskDeviceId, status, createdAt])
  @@index([organizationId, createdAt])
  @@index([storeId, createdAt])
  @@index([status, expiresAt])
  @@index([expiresAt])
  @@index([currentPersonAssetId])
  @@map("try_on_sessions")
}

model TryOnAsset {
  id                         String               @id @db.Uuid
  sessionId                  String               @map("try_on_session_id") @db.Uuid
  purpose                    TryOnAssetPurpose
  assignmentScope            KioskAssignmentScope @map("assignment_scope")
  organizationId             String?              @map("organization_id") @db.Uuid
  storeId                    String?              @map("store_id") @db.Uuid
  kioskDeviceId              String?              @map("kiosk_device_id") @db.Uuid
  storageKey                 String               @unique @map("storage_key") @db.VarChar(512)
  contentType                String?              @map("content_type") @db.VarChar(80)
  sizeBytes                  Int?                 @map("size_bytes")
  width                      Int?
  height                     Int?
  expiresAt                  DateTime             @map("expires_at") @db.Timestamptz(3)
  deletedAt                  DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  session                    TryOnSession         @relation("TryOnSessionAssets", fields: [sessionId], references: [id], onDelete: Cascade)
  currentForSessions         TryOnSession[]       @relation("TryOnSessionCurrentPersonAsset")
  organization               Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store                      Store?               @relation(fields: [organizationId, storeId], references: [orgId, id], onDelete: Restrict)
  kioskDevice                KioskDevice?         @relation(fields: [kioskDeviceId], references: [id], onDelete: SetNull)
  personForRuns             KioskTryOnRun[]       @relation("KioskTryOnRunPersonAsset")
  garmentForRuns            KioskTryOnRun[]       @relation("KioskTryOnRunGarmentAsset")
  resultForRuns             KioskTryOnRun[]       @relation("KioskTryOnRunResultAsset")
  personForLooks            TryOnLook[]           @relation("TryOnLookPersonAsset")
  garmentForLooks           TryOnLook[]           @relation("TryOnLookGarmentAsset")
  resultForLooks            TryOnLook[]           @relation("TryOnLookResultAsset")

  @@index([sessionId, purpose, createdAt])
  @@index([kioskDeviceId, purpose, createdAt])
  @@index([organizationId, purpose, createdAt])
  @@index([storeId, purpose, createdAt])
  @@index([purpose, expiresAt])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("try_on_assets")
}

model TryOnLook {
