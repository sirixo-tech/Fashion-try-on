generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationMembershipRole {
  ORGANIZATION_OWNER
  ORGANIZATION_ADMIN
  ORGANIZATION_STAFF
  STORE_OWNER
  STORE_MANAGER
  STORE_STAFF
  KIOSK_OPERATOR
}

enum MembershipStatus {
  INVITED
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  REVOKED
}

enum MembershipStoreScopeMode {
  ALL_STORES
  SELECTED_STORES
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PlatformRole {
  SELFX_SUPPORT_ADMIN
  SELFX_STAFF_ADMIN
  SELFX_SUPER_ADMIN
}

enum PlatformRoleAssignmentStatus {
  ACTIVE
  REVOKED
}

enum PermissionApplicability {
  PLATFORM_ONLY
  STORE
  BOTH
}

enum KioskAssignmentScope {
  PLATFORM
  ORGANIZATION
  STORE
}

enum KioskDeviceStatus {
  ACTIVE
  INACTIVE
  REVOKED
  DELETED
}

enum KioskPairingSessionStatus {
  PENDING
  CLAIMED
  EXPIRED
  CANCELLED
}

enum KioskCustomerUploadSessionStatus {
  WAITING
  UPLOADING
  VALIDATING
  READY
  REJECTED
  EXPIRED
  CONSUMED
  CANCELLED
}

enum KioskCustomerUploadPurpose {
  MODEL
  GARMENT
}

enum TryOnSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum TryOnAssetPurpose {
  PERSON
  GARMENT
  RESULT
}

enum KioskIdleMode {
  STATIC
  SLIDESHOW
}

enum KioskConfigurationAssetType {
  BUNDLED_IMAGE
  REMOTE_IMAGE
  UPLOADED_IMAGE
}

enum KioskConfigurationSoundProfile {
  SELFX_SIGNATURE
  SOFT
  STUDIO
  MINIMAL
  MUTED
}

enum KioskConfigurationGarmentIntent {
  TOP
  BOTTOM
  FULL_OUTFIT
}

enum CatalogProductScope {
  PLATFORM_DEFAULT
  STORE
}

enum OrganizationApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum ActivationRequirementStatus {
  PENDING
  SATISFIED
  WAIVED
}

model User {
  id                            String                              @id @db.Uuid
  email                         String                              @unique @db.VarChar(320)
  passwordHash                  String                              @map("password_hash")
  displayName                   String?                             @map("display_name") @db.VarChar(160)
  status                        UserStatus                          @default(ACTIVE)
  emailVerifiedAt               DateTime?                           @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt                   DateTime?                           @map("last_login_at") @db.Timestamptz(3)
  createdAt                     DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditLogs                     AuditLog[]                          @relation("AuditActor")
  applicationsReviewed          OrganizationApplication[]           @relation("OrganizationApplicationReviewedBy")
  applicationsSubmitted         OrganizationApplication[]           @relation("OrganizationApplicationSubmittedBy")
  memberships                   OrganizationMembership[]
  platformRoleAssignments       PlatformRoleAssignment[]            @relation("PlatformRoleAssignedToUser")
  platformRolesAssigned         PlatformRoleAssignment[]            @relation("PlatformRoleAssignedByUser")
  platformAccessRoleAssignments PlatformUserAccessRole[]            @relation("PlatformUserAccessRoleAssignedToUser")
  platformAccessRolesAssigned   PlatformUserAccessRole[]            @relation("PlatformUserAccessRoleAssignedByUser")
  requirementsReviewed          OrganizationActivationRequirement[] @relation("ActivationRequirementReviewedBy")
  storeMembershipRolesAssigned  StoreMembershipRole[]               @relation("StoreMembershipRoleAssignedBy")
  storePermissionGrantsAssigned StorePermissionGrant[]              @relation("StorePermissionGrantGrantedByUser")
  sessions                      UserSession[]
  kioskPairingClaims            KioskPairingSession[]               @relation("KioskPairingClaimedBy")
  kioskConfigurationsUpdated    KioskDeviceConfiguration[]          @relation("KioskConfigurationUpdatedBy")

  @@map("users")
}

model UserSession {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  deviceLabel      String?   @map("device_label") @db.VarChar(160)
  userAgentJson    Json?     @map("user_agent_json")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Organization {
  id                     String                              @id @db.Uuid
  name                   String                              @db.VarChar(200)
  slug                   String                              @unique @db.VarChar(120)
  status                 OrganizationStatus                  @default(PENDING_ACTIVATION)
  timezone               String                              @default("UTC") @db.VarChar(64)
  settings               Json?
  createdAt              DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  activationRequirements OrganizationActivationRequirement[]
  applications           OrganizationApplication[]
  auditLogs              AuditLog[]
  memberships            OrganizationMembership[]
  roles                  StoreRole[]
  permissionGrants       StorePermissionGrant[]
  stores                 Store[]
  kioskDevices           KioskDevice[]
  tryOnSessions          TryOnSession[]
  tryOnAssets            TryOnAsset[]
  tryOnLooks             TryOnLook[]
  tryOnShareCapabilities TryOnShareCapability[]
  productCategories      ProductCategory[]
  products               Product[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id              String                     @id @db.Uuid
  userId          String                     @map("user_id") @db.Uuid
  orgId           String                     @map("organization_id") @db.Uuid
  role            OrganizationMembershipRole
  storeScopeMode  MembershipStoreScopeMode   @default(SELECTED_STORES) @map("store_scope_mode")
  status          MembershipStatus           @default(ACTIVE)
  joinedAt        DateTime?                  @map("joined_at") @db.Timestamptz(3)
  suspendedAt     DateTime?                  @map("suspended_at") @db.Timestamptz(3)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization               @relation(fields: [orgId], references: [id], onDelete: Restrict)
  roleAssignments StoreMembershipRole[]
  storeScopes     MembershipStoreScope[]
  user            User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([orgId, id])
  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
  @@index([orgId, status])
  @@index([orgId, storeScopeMode])
  @@map("organization_memberships")
}

model OrganizationApplication {
  id                     String                              @id @db.Uuid
  organizationId         String                              @map("organization_id") @db.Uuid
  submittedByUserId      String                              @map("submitted_by_user_id") @db.Uuid
  status                 OrganizationApplicationStatus       @default(DRAFT)
  submittedAt            DateTime?                           @map("submitted_at") @db.Timestamptz(3)
  reviewStartedAt        DateTime?                           @map("review_started_at") @db.Timestamptz(3)
  reviewedByUserId       String?                             @map("reviewed_by_user_id") @db.Uuid
  approvedAt             DateTime?                           @map("approved_at") @db.Timestamptz(3)
  rejectedAt             DateTime?                           @map("rejected_at") @db.Timestamptz(3)
  reviewNotes            String?                             @map("review_notes") @db.Text
  requirementsStatusJson Json?                               @map("requirements_status_json")
  createdAt              DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization           Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requirements           OrganizationActivationRequirement[]
  reviewedBy             User?                               @relation("OrganizationApplicationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  submittedBy            User                                @relation("OrganizationApplicationSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([submittedByUserId])
  @@index([status, submittedAt])
  @@index([reviewedByUserId])
  @@map("organization_applications")
}

model OrganizationActivationRequirement {
  id               String                      @id @db.Uuid
  organizationId   String                      @map("organization_id") @db.Uuid
  applicationId    String                      @map("application_id") @db.Uuid
  code             String                      @db.VarChar(120)
  required         Boolean                     @default(true)
  status           ActivationRequirementStatus @default(PENDING)
  metadata         Json?                       @map("metadata_json")
  satisfiedAt      DateTime?                   @map("satisfied_at") @db.Timestamptz(3)
  waivedAt         DateTime?                   @map("waived_at") @db.Timestamptz(3)
  reviewedByUserId String?                     @map("reviewed_by_user_id") @db.Uuid
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  application      OrganizationApplication     @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reviewedBy       User?                       @relation("ActivationRequirementReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([applicationId, code])
  @@index([organizationId])
  @@index([applicationId, status])
  @@index([reviewedByUserId])
  @@map("organization_activation_requirements")
}

model Store {
  id           String                 @id @db.Uuid
  orgId        String                 @map("organization_id") @db.Uuid
  name         String                 @db.VarChar(200)
  code         String?                @db.VarChar(80)
  status       StoreStatus            @default(ACTIVE)
  timezone     String                 @default("UTC") @db.VarChar(64)
  addressJson  Json?                  @map("address_json")
  settings     Json?
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditLogs    AuditLog[]
  kioskDevices KioskDevice[]
  organization Organization           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  storeScopes  MembershipStoreScope[]
  tryOnSessions TryOnSession[]
  tryOnAssets   TryOnAsset[]
  tryOnLooks    TryOnLook[]
  tryOnShareCapabilities TryOnShareCapability[]

  @@unique([orgId, id])
  @@unique([orgId, code])
  @@index([orgId])
  @@index([orgId, status])
  @@map("stores")
}

model MembershipStoreScope {
  id           String                 @id @db.Uuid
  orgId        String                 @map("organization_id") @db.Uuid
  membershipId String                 @map("membership_id") @db.Uuid
  storeId      String                 @map("store_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  membership   OrganizationMembership @relation(fields: [orgId, membershipId], references: [orgId, id], onDelete: Cascade)
  store        Store                  @relation(fields: [orgId, storeId], references: [orgId, id], onDelete: Cascade)

  @@unique([membershipId, storeId])
  @@index([orgId])
  @@index([storeId])
  @@map("membership_store_scopes")
}

model Permission {
  id                      String                         @id @db.Uuid
  code                    String                         @unique @db.VarChar(120)
  module                  String                         @db.VarChar(80)
  action                  String                         @db.VarChar(80)
  label                   String                         @db.VarChar(160)
  description             String?                        @db.Text
  applicability           PermissionApplicability        @default(STORE)
  isSystem                Boolean                        @default(true) @map("is_system")
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  platformRolePermissions PlatformAccessRolePermission[]
  rolePermissions         StoreRolePermission[]
  storeGrants             StorePermissionGrant[]

  @@index([module, action])
  @@index([applicability])
  @@map("permissions")
}

model PlatformAccessRole {
  id          String                         @id @db.Uuid
  systemCode  String?                        @map("system_code") @db.VarChar(80)
  name        String                         @db.VarChar(120)
  description String?                        @db.Text
  isSystem    Boolean                        @default(false) @map("is_system")
  isActive    Boolean                        @default(true) @map("is_active")
  createdAt   DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions PlatformAccessRolePermission[]
  assignments PlatformUserAccessRole[]

  @@unique([name])
  @@unique([systemCode])
  @@index([isActive])
  @@map("platform_roles")
}

model PlatformAccessRolePermission {
  id           String             @id @db.Uuid
  roleId       String             @map("role_id") @db.Uuid
  permissionId String             @map("permission_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  permission   Permission         @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  role         PlatformAccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("platform_role_permissions")
}

model PlatformUserAccessRole {
  id               String                       @id @db.Uuid
  userId           String                       @map("user_id") @db.Uuid
  roleId           String                       @map("role_id") @db.Uuid
  status           PlatformRoleAssignmentStatus @default(ACTIVE)
  assignedByUserId String?                      @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime                     @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt        DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignedBy       User?                        @relation("PlatformUserAccessRoleAssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  role             PlatformAccessRole           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user             User                         @relation("PlatformUserAccessRoleAssignedToUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId, status])
  @@index([userId, status])
  @@index([assignedByUserId])
  @@map("platform_user_roles")
}

model PlatformSetting {
  key       String   @id @db.VarChar(120)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

model ProductCategory {
  id             String              @id @db.Uuid
  catalogKey     String              @unique @map("catalog_key") @db.VarChar(220)
  scope          CatalogProductScope
  organizationId String?             @map("organization_id") @db.Uuid
  name           String              @db.VarChar(120)
  slug           String              @db.VarChar(120)
  audience       String?             @db.VarChar(40)
  active         Boolean             @default(true)
  sortOrder      Int                 @default(0) @map("sort_order")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products       Product[]

  @@index([scope, active, sortOrder])
  @@index([organizationId, active, sortOrder])
  @@index([audience, slug])
  @@map("product_categories")
}

model Product {
  id               String              @id @db.Uuid
  catalogKey       String              @unique @map("catalog_key") @db.VarChar(260)
  scope            CatalogProductScope
  organizationId   String?             @map("organization_id") @db.Uuid
  categoryId       String              @map("category_id") @db.Uuid
  name             String              @db.VarChar(180)
  slug             String              @db.VarChar(160)
  description      String?             @db.Text
  audience         String              @db.VarChar(40)
  active           Boolean             @default(true)
  vtoEnabled       Boolean             @default(false) @map("vto_enabled")
  sortOrder        Int                 @default(0) @map("sort_order")
  garmentIntent    String              @map("garment_intent") @db.VarChar(40)
  garmentCategory  String              @map("garment_category") @db.VarChar(40)
  garmentPhotoType String              @default("AUTO") @map("garment_photo_type") @db.VarChar(40)
  imageUrl         String?             @map("image_url") @db.Text
  imageStorageKey  String?             @map("image_storage_key") @db.VarChar(512)
  imageContentType String?             @map("image_content_type") @db.VarChar(80)
  imageWidth       Int?                @map("image_width")
  imageHeight      Int?                @map("image_height")
  priceAmountCents Int?                @map("price_amount_cents")
  priceCurrency    String?             @map("price_currency") @db.VarChar(3)
  productUrl       String?             @map("product_url") @db.Text
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category         ProductCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tryOnRuns        KioskTryOnRun[]
  tryOnLooks       TryOnLook[]

  @@index([scope, active, vtoEnabled, audience, sortOrder])
  @@index([organizationId, active, vtoEnabled, audience, sortOrder])
  @@index([categoryId, active, vtoEnabled, sortOrder])
  @@index([garmentIntent])
  @@map("products")
}

model StoreRole {
  id              String                @id @db.Uuid
  orgId           String                @map("organization_id") @db.Uuid
  systemCode      String?               @map("system_code") @db.VarChar(80)
  name            String                @db.VarChar(120)
  description     String?               @db.Text
  isSystem        Boolean               @default(false) @map("is_system")
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  membershipRoles StoreMembershipRole[]
  permissions     StoreRolePermission[]

  @@unique([orgId, id])
  @@unique([orgId, name])
  @@unique([orgId, systemCode])
  @@index([orgId, isActive])
  @@map("store_roles")
}

model StoreRolePermission {
  id           String     @id @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  role         StoreRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("store_role_permissions")
}

model StoreMembershipRole {
  id               String                 @id @db.Uuid
  orgId            String                 @map("organization_id") @db.Uuid
  membershipId     String                 @map("membership_id") @db.Uuid
  roleId           String                 @map("role_id") @db.Uuid
  assignedByUserId String?                @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime               @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedBy       User?                  @relation("StoreMembershipRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  membership       OrganizationMembership @relation(fields: [orgId, membershipId], references: [orgId, id], onDelete: Cascade)
  role             StoreRole              @relation(fields: [orgId, roleId], references: [orgId, id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([orgId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("store_membership_roles")
}

model StorePermissionGrant {
  id              String       @id @db.Uuid
  storeTenantId   String       @map("store_tenant_id") @db.Uuid
  permissionId    String       @map("permission_id") @db.Uuid
  grantedByUserId String?      @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  grantedBy       User?        @relation("StorePermissionGrantGrantedByUser", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  permission      Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  storeTenant     Organization @relation(fields: [storeTenantId], references: [id], onDelete: Cascade)

  @@unique([storeTenantId, permissionId])
  @@index([permissionId])
  @@index([grantedByUserId])
  @@map("store_permission_grants")
}

model PlatformRoleAssignment {
  id               String                       @id @db.Uuid
  userId           String                       @map("user_id") @db.Uuid
  role             PlatformRole
  status           PlatformRoleAssignmentStatus @default(ACTIVE)
  assignedByUserId String?                      @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime                     @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt        DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignedBy       User?                        @relation("PlatformRoleAssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  user             User                         @relation("PlatformRoleAssignedToUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, role])
  @@index([role, status])
  @@index([assignedByUserId])
  @@map("platform_role_assignments")
}

model KioskDevice {
  id                     String                       @id @db.Uuid
  displayName            String                       @map("display_name") @db.VarChar(160)
  status                 KioskDeviceStatus            @default(ACTIVE)
  assignmentScope        KioskAssignmentScope         @default(PLATFORM) @map("assignment_scope")
  organizationId         String?                      @map("organization_id") @db.Uuid
  storeId                String?                      @map("store_id") @db.Uuid
  platform               String?                      @db.VarChar(80)
  appVersion             String?                      @map("app_version") @db.VarChar(80)
  installationId         String?                      @map("installation_id") @db.VarChar(160)
  pairedAt               DateTime                     @default(now()) @map("paired_at") @db.Timestamptz(3)
  lastSeenAt             DateTime?                    @map("last_seen_at") @db.Timestamptz(3)
  inactiveAt             DateTime?                    @map("inactive_at") @db.Timestamptz(3)
  revokedAt              DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  deletedAt              DateTime?                    @map("deleted_at") @db.Timestamptz(3)
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization           Organization?                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store                  Store?                       @relation(fields: [organizationId, storeId], references: [orgId, id], onDelete: Restrict)
  customerUploadSessions KioskCustomerUploadSession[]
  tryOnRuns              KioskTryOnRun[]
  tryOnSessions          TryOnSession[]
  tryOnAssets            TryOnAsset[]
  tryOnLooks             TryOnLook[]
  tryOnShareCapabilities TryOnShareCapability[]
  pairingSessions        KioskPairingSession[]
  sessions               KioskDeviceSession[]
  configuration          KioskDeviceConfiguration?

  @@index([status])
  @@index([assignmentScope])
  @@index([organizationId])
  @@index([storeId])
  @@index([organizationId, storeId])
