{
  "name": "@selfx/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude \"dist/**\"",
    "bootstrap:staff": "tsx src/scripts/bootstrap-staff-user.ts",
    "bootstrap:platform-admin": "tsx src/scripts/bootstrap-platform-admin.ts",
    "bootstrap:production-admin": "node dist/scripts/bootstrap-production-admin.js",
    "bootstrap:demo-logins": "tsx src/scripts/bootstrap-demo-logins.ts",
    "catalog:sync-default-assets": "tsx src/scripts/sync-default-catalog-assets.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.3",
    "@selfx/database": "0.0.0",
    "@selfx/shared": "0.0.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "fashn": "^0.15.0",
    "google-auth-library": "^11.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.4",
    "vitest": "^4.1.10"
  }
}
