FROM node:24-bookworm-slim

ARG ANDROID_CMDLINE_TOOLS_REVISION=15859902
ARG ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    SELFX_APK_JAVA_PATH=/usr/bin/java \
    SELFX_APK_AAPT_PATH=/opt/android-sdk/build-tools/36.0.0/aapt \
    SELFX_APK_SIGNER_JAR_PATH=/opt/android-sdk/build-tools/36.0.0/lib/apksigner.jar \
    PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl openjdk-17-jre-headless unzip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p "${ANDROID_HOME}/cmdline-tools" /tmp/android-command-line-tools \
    && curl --fail --silent --show-error --location \
      "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_REVISION}_latest.zip" \
      --output /tmp/android-command-line-tools.zip \
    && echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/android-command-line-tools.zip" | sha256sum --check --status \
    && unzip -q /tmp/android-command-line-tools.zip -d /tmp/android-command-line-tools \
    && mv /tmp/android-command-line-tools/cmdline-tools "${ANDROID_HOME}/cmdline-tools/latest" \
    && rm -rf /tmp/android-command-line-tools /tmp/android-command-line-tools.zip \
    && java -version

RUN yes | sdkmanager --sdk_root="${ANDROID_HOME}" --licenses >/dev/null \
    && sdkmanager --sdk_root="${ANDROID_HOME}" "build-tools;36.0.0" \
    && test -x "${SELFX_APK_AAPT_PATH}" \
    && test -r "${SELFX_APK_SIGNER_JAR_PATH}"

WORKDIR /app
COPY . .

RUN npm ci \
    && npm run build --workspace=@selfx/api \
    && sh ./tools/verify-api-apk-tools.sh

EXPOSE 3001
CMD ["sh", "./tools/start-api-with-apk-tools.sh"]
