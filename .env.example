# SelfX local environment template.
# Copy to .env for local development and keep real secrets out of git.

NODE_ENV=development

# Application ports.
WEB_PORT=3002
API_PORT=3001
WORKER_CONCURRENCY=1
# Automatically mark expired unpaid shopping orders; stock deadlines are enforced even if the sweep is delayed.
SHOPPING_EXPIRY_ENABLED=true

# Public browser-facing URLs.
NEXT_PUBLIC_SELFX_WEB_BASE_URL=http://localhost:3002
NEXT_PUBLIC_SELFX_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side backend URLs.
SELFX_WEB_BASE_URL=http://localhost:3002
# Enable only after Shopify test approval, migrations and configuration validation.
SHOPIFY_BILLING_ENABLED=false
SHOPIFY_BILLING_TEST_MODE=true
SHOPIFY_RECONCILIATION_ENABLED=true
SELFX_API_BASE_URL=http://localhost:3001

# Shopify read-only app connection. Keep every value server-side.
# Configure the exact callback URL shown below in Shopify's Dev Dashboard.
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
SHOPIFY_API_VERSION=2026-07
# Shared only by the Shopify app server and SelfX API. Use at least 32 random characters.
SELFX_SHOPIFY_APP_SERVICE_TOKEN=replace-with-long-random-shopify-service-token
# Shopify app storage key. Generate separately from the backend integration key.
SELFX_SHOPIFY_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SELFX_SHOPIFY_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
SELFX_INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SELFX_INTEGRATION_ENCRYPTION_KEY_VERSION=v1
# Callback: http://localhost:3001/api/v1/admin/integrations/shopify/oauth/callback

# Public API webhook signing.
# Keep server-side. Used to derive per-endpoint webhook signing secrets.
SELFX_WEBHOOK_SIGNING_KEY=CHANGE_ME_TO_A_LONG_RANDOM_WEBHOOK_SIGNING_KEY
SELFX_WEBHOOK_RETRY_ENABLED=true
SELFX_WEBHOOK_RETRY_INTERVAL_MS=60000
SELFX_WEBHOOK_RETRY_MAX_ATTEMPTS=5
SELFX_WEBHOOK_RETRY_BATCH_SIZE=25

# Public API rate limits are per API key and per route category.
SELFX_PUBLIC_API_RATE_LIMIT_ENABLED=true

# Server-side PostgreSQL connection strings.
# Keep real database credentials in .env only; do not expose these through NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/TEST_DATABASE?schema=public

# Cookies and browser security.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_NAME=selfx_refresh_token
# Optional staff/Store-owner Google sign-in. Keep disabled until the OAuth client is configured.
SELFX_GOOGLE_AUTH_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Production: use https://YOUR-WEB-DOMAIN/api/v1/auth/google/callback via the same-origin proxy.
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# CORS.
CORS_ORIGINS=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3002

# Staff/admin authentication.
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SERVER_SIDE_SECRET
# Customer mobile auth is a separate security boundary; enable after its migration.
SELFX_CUSTOMER_AUTH_ENABLED=false
SELFX_CUSTOMER_JWT_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_CUSTOMER_SECRET
# Native Google ID-token audiences (web/server client IDs), comma-separated.
SELFX_CUSTOMER_GOOGLE_CLIENT_IDS=
# Approved iOS bundle identifiers for Sign in with Apple.
SELFX_CUSTOMER_APPLE_CLIENT_IDS=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_SERVER_SIDE_REFRESH_PEPPER
REFRESH_SESSION_TTL_SECONDS=2592000
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REFRESH_RATE_LIMIT_MAX=20
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60

# Controlled local/dev staff bootstrap. Do not enable open public registration.
SELFX_AUTH_BOOTSTRAP_ENABLED=false
SELFX_BOOTSTRAP_STAFF_EMAIL=admin@example.test
SELFX_BOOTSTRAP_STAFF_PASSWORD=CHANGE_ME_FOR_LOCAL_BOOTSTRAP_ONLY
SELFX_BOOTSTRAP_STAFF_DISPLAY_NAME=SelfX Admin

# Controlled local/dev platform-admin role assignment.
# Requires an existing user and never runs automatically.
SELFX_PLATFORM_BOOTSTRAP_ENABLED=false
SELFX_PLATFORM_BOOTSTRAP_EMAIL=admin@example.test

# Controlled demo login bootstrap and quick access for role walkthroughs.
# Requires an explicit command and never runs automatically.
# Creates dev-only accounts:
# super-admin@selfx.local, support-admin@selfx.local,
# platform-staff-admin@selfx.local, store-owner@selfx.local,
# store-admin@selfx.local, store-manager@selfx.local, store-staff@selfx.local
SELFX_DEMO_LOGINS_BOOTSTRAP_ENABLED=false
SELFX_ALLOW_DEPLOYED_DEMO_LOGINS=false
SELFX_DEMO_LOGIN_PASSWORD=CHANGE_ME_FOR_LOCAL_DEMO_ONLY
SELFX_DEMO_ORGANIZATION_NAME=SelfX Demo Retail
SELFX_DEMO_ORGANIZATION_SLUG=selfx-demo-retail
SELFX_DEMO_STORE_NAME=SelfX Demo Store
SELFX_DEMO_STORE_CODE=main
NEXT_PUBLIC_SELFX_DEMO_LOGINS_ENABLED=false
NEXT_PUBLIC_SELFX_DEMO_LOGIN_PASSWORD=CHANGE_ME_FOR_LOCAL_DEMO_ONLY

# CORE VTO-1 internal development lab.
# Enable only in controlled local/development environments.
TRYON_LAB_ENABLED=false

# Server-side AI provider routing.
# Supported preview providers: fashn, openai.
# Supported Try-On providers: fashn, google.
SELFX_GARMENT_PREVIEW_PROVIDER=fashn
SELFX_TRYON_PROVIDER=fashn
# Garment Try-On image limits. Upload max is what SelfX accepts; provider target
# is the safe post-normalization size SelfX sends to the selected provider.
GARMENT_TRYON_UPLOAD_MAX_IMAGE_BYTES=10485760
GARMENT_TRYON_PROVIDER_MAX_IMAGE_BYTES=7340032
GARMENT_TRYON_PROVIDER_TARGET_IMAGE_BYTES=6815744
# Safe backend garment preprocessing before provider submission.
# Keep disabled until the environment is ready to evaluate provider output quality.
GARMENT_PREPROCESSING_ENABLED=false
# Optional local placeholder mask generation for testing provider-neutral mask plumbing.
# Requires GARMENT_PREPROCESSING_ENABLED=true. Does not use external APIs.
GARMENT_MASK_GENERATION_ENABLED=false

# Required when SELFX_GARMENT_PREVIEW_PROVIDER=fashn or SELFX_TRYON_PROVIDER=fashn.
FASHN_API_KEY=

# Required when SELFX_TRYON_PROVIDER=google.
# For local development, run `gcloud auth application-default login`.
# Explicit Google credential env vars are optional deployment overrides and are
# intentionally not required for local ADC.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VTO_MODEL=virtual-try-on-001
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS_JSON_BASE64=

# Required for server-side Perfect Corp jewellery Try-On.
# Keep the API key on @selfx/api only; never expose it through NEXT_PUBLIC_*.
SELFX_JEWELLERY_TRY_ON_PROVIDER=perfect-corp
SELFX_PERFECT_CORP_JEWELLERY_TRY_ON_ENABLED=false
PERFECT_CORP_API_BASE_URL=https://yce-api-01.makeupar.com
PERFECT_CORP_API_KEY=
PERFECT_CORP_JEWELLERY_TRY_ON_MODEL=2d-vto-v1.0
PERFECT_CORP_HTTP_TIMEOUT_MS=30000
# Jewellery Try-On image limits are intentionally separate from garments because
# jewellery uses a different provider and validation path.
JEWELLERY_TRYON_UPLOAD_MAX_IMAGE_BYTES=10485760
JEWELLERY_TRYON_PROVIDER_MAX_IMAGE_BYTES=10485760
JEWELLERY_TRYON_PROVIDER_TARGET_IMAGE_BYTES=10485760

# Server-side kiosk garment extraction preview.
# Required only when SELFX_GARMENT_PREVIEW_PROVIDER=openai.
# Keep all provider keys on @selfx/api only; never expose them through Flutter
# or NEXT_PUBLIC_*.
OPENAI_API_KEY=
GARMENT_EXTRACTION_OPENAI_MODEL=gpt-image-1

# KIOSK-4A production device provisioning.
# Keep all values server-side on @selfx/api only.
KIOSK_PAIRING_CODE_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_PAIRING_CODE_PEPPER
KIOSK_PROVISIONING_SECRET_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_PROVISIONING_SECRET_PEPPER
KIOSK_DEVICE_REFRESH_TOKEN_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_DEVICE_REFRESH_PEPPER
KIOSK_DEVICE_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_DEVICE_JWT_SECRET
KIOSK_PAIRING_TTL_SECONDS=480
KIOSK_DEVICE_ACCESS_TOKEN_TTL_SECONDS=900
KIOSK_DEVICE_REFRESH_SESSION_TTL_SECONDS=2592000

# KIOSK-4C secure customer mobile photo upload.
# Keep all values server-side on @selfx/api only.
KIOSK_CUSTOMER_UPLOAD_TOKEN_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_CUSTOMER_UPLOAD_PEPPER
KIOSK_CUSTOMER_UPLOAD_TTL_SECONDS=300
SELFX_PUBLIC_WEB_BASE_URL=http://localhost:3002
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Defaults to virtual-host style (bucket.endpoint/key); set path for older path-style buckets.
OBJECT_STORAGE_URL_STYLE=virtual

# Future Redis/BullMQ variables are reserved for the approved queue phase.
# REDIS_URL=

# Future AI provider variables are reserved for approved provider phases.

# Future OTP variables are reserved for the approved authentication/customer identity phases.
# OTP_PROVIDER=
# OTP_API_KEY=

# Future WooCommerce variables are reserved for the approved WooCommerce integration phase.
# WOOCOMMERCE_CLIENT_ID=
# WOOCOMMERCE_CLIENT_SECRET=

# Merchant shopping payment configuration; API only. Base64-encoded random 32-byte key.
# Use a separate key from commerce integration encryption. Back up securely before use.
# Account configuration can be saved without confirming test/live; no payment is initiated.
SELFX_PAYMENT_ENCRYPTION_KEY=
SELFX_PAYMENT_ENCRYPTION_KEY_VERSION=v1
# Optional JSON map of previous key-version -> Base64 key, for pending attempts during rotation.
SELFX_PAYMENT_PREVIOUS_ENCRYPTION_KEYS=
# Test-only provider calls for Store execution and the isolated platform test workspace.
# Keep disabled until UAT credentials and Dynamic QR access are confirmed.
SELFX_PHONEPE_UAT_ENABLED=false
# Store-only INR 1 live account verification; never inferred from the UAT switch.
# Obtain PhonePe's confirmed v3 Dynamic QR base (before /v3/qr/init) for the account.
# HTTPS PhonePe-owned host only. No guessed production endpoint is supplied.
SELFX_PHONEPE_PRODUCTION_ENABLED=false
# Actual order checkout, separate from the optional INR 1 account verification switch.
# Requires selected confirmed Store PRODUCTION account, enabled Platform policy,
# confirmed production endpoint and a secure reachable payment callback origin.
SELFX_PHONEPE_CHECKOUT_ENABLED=false
SELFX_PHONEPE_PRODUCTION_BASE_URL=
SELFX_PAYMENT_CALLBACK_BASE_URL=
PAYMENT_RECONCILIATION_ENABLED=true

# Platform mail: SMTP account details live in Platform Settings -> Mail Settings.
# API-only random Base64-encoded 32-byte key; retain securely across deployments.
SELFX_MAIL_ENCRYPTION_KEY=
SELFX_MAIL_ENCRYPTION_KEY_VERSION=v1
# Optional JSON map of prior version -> key during deliberate key rotation.
SELFX_MAIL_PREVIOUS_ENCRYPTION_KEYS=
# Reset links use the existing SELFX_PUBLIC_WEB_BASE_URL (HTTPS origin in production).

# Future billing variables are reserved for the approved subscription/billing phase.
# APK release verification on API hosts: Android SDK Build Tools aapt + apksigner.jar and Java.
# Absolute executable/JAR paths; use the release signing certificate fingerprint, never a debug certificate in production.
SELFX_APK_AAPT_PATH=
SELFX_APK_SIGNER_JAR_PATH=
SELFX_APK_JAVA_PATH=java
SELFX_APK_SIGNER_SHA256=
SELFX_APK_PACKAGE_NAME=com.selfx.kiosk
# BILLING_PROVIDER=
# BILLING_WEBHOOK_SECRET=

# Customer app public destinations and optional phone alerts (@selfx/api only).
# Leave Firebase credentials empty until the project is configured.
SELFX_CUSTOMER_PUBLIC_WEB_URL=https://selfxweb-production.up.railway.app
SELFX_SUPPORT_EMAIL=sirixollc@gmail.com
SELFX_CUSTOMER_FCM_PROJECT_ID=
SELFX_CUSTOMER_FCM_SERVICE_ACCOUNT_JSON=
# Customer app release certificate; never put the keystore or signing passwords here.
SELFX_CUSTOMER_APK_PACKAGE_NAME=com.selfx.selfx_customer
SELFX_CUSTOMER_APK_SIGNER_SHA256=
