DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=shopify_app

SHOPIFY_SHOP_DOMAIN=merchant-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-read-products-token
SHOPIFY_API_VERSION=2026-07
SCOPES=read_products,read_themes,write_app_proxy

SELFX_API_BASE_URL=https://api.selfx.example
SELFX_WEB_BASE_URL=https://app.selfx.example
SELFX_STOREFRONT_TRYON_URL=https://app.selfx.example/try-on/shopify
SELFX_INTEGRATION_TOKEN=replace-with-selfx-shopify-token

SHOPIFY_PRODUCT_PAGE_SIZE=50
SELFX_CATALOG_BATCH_SIZE=25
