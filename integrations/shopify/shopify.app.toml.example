name = "SelfX Virtual Try-On"
client_id = "replace-with-shopify-client-id"
application_url = "https://app.selfx.example/app/integrations/shopify"
embedded = false

[access_scopes]
scopes = "read_products,read_themes,write_app_proxy"

[auth]
redirect_urls = [
  "https://api.selfx.example/api/v1/admin/integrations/shopify/oauth/callback"
]

[webhooks]
api_version = "2026-07"

[app_proxy]
url = "/apps/selfx-tryon"
subpath = "selfx-tryon"
prefix = "apps"

[[webhooks.subscriptions]]
topics = [
  "products/create",
  "products/update",
  "products/delete",
  "app/uninstalled"
]
uri = "https://api.selfx.example/api/v1/integrations/shopify/webhooks"
