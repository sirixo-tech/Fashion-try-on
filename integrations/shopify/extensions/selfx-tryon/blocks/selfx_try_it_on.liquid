{% assign product = block.settings.product %}
{% assign selfx_launch_url = block.settings.selfx_launch_url | default: '/apps/selfx-tryon/launch' %}
{% assign selfx_locale = block.settings.button_language | default: 'auto' %}
{% if selfx_locale == 'auto' %}
  {% assign selfx_locale = request.locale.iso_code | split: '-' | first | downcase %}
{% endif %}

{% case selfx_locale %}
  {% when 'es' %}
    {% assign selfx_default_button_label = 'Probar ahora' %}
    {% assign selfx_default_helper_text = 'Mira como te queda este producto con SelfX.' %}
    {% assign selfx_default_alert = 'SelfX Try-On aun no esta conectado.' %}
  {% when 'ar' %}
    {% assign selfx_default_button_label = 'جربه الآن' %}
    {% assign selfx_default_helper_text = 'شاهد كيف يبدو هذا المنتج عليك مع SelfX.' %}
    {% assign selfx_default_alert = 'لم يتم ربط SelfX Try-On بعد.' %}
  {% when 'hi' %}
    {% assign selfx_default_button_label = 'अभी ट्राय करें' %}
    {% assign selfx_default_helper_text = 'SelfX के साथ देखें कि यह उत्पाद आप पर कैसा दिखता है.' %}
    {% assign selfx_default_alert = 'SelfX Try-On अभी कनेक्ट नहीं है.' %}
  {% when 'fr' %}
    {% assign selfx_default_button_label = 'Essayer maintenant' %}
    {% assign selfx_default_helper_text = 'Voyez comment ce produit vous va avec SelfX.' %}
    {% assign selfx_default_alert = 'SelfX Try-On n est pas encore connecte.' %}
  {% when 'de' %}
    {% assign selfx_default_button_label = 'Jetzt anprobieren' %}
    {% assign selfx_default_helper_text = 'Sieh mit SelfX, wie dieses Produkt an dir aussieht.' %}
    {% assign selfx_default_alert = 'SelfX Try-On ist noch nicht verbunden.' %}
  {% when 'pt' %}
    {% assign selfx_default_button_label = 'Experimentar agora' %}
    {% assign selfx_default_helper_text = 'Veja como este produto fica em voce com SelfX.' %}
    {% assign selfx_default_alert = 'SelfX Try-On ainda nao esta conectado.' %}
  {% when 'it' %}
    {% assign selfx_default_button_label = 'Prova ora' %}
    {% assign selfx_default_helper_text = 'Guarda come ti sta questo prodotto con SelfX.' %}
    {% assign selfx_default_alert = 'SelfX Try-On non e ancora collegato.' %}
  {% else %}
    {% assign selfx_default_button_label = 'Try It On' %}
    {% assign selfx_default_helper_text = 'See how this product looks on you with SelfX.' %}
    {% assign selfx_default_alert = 'SelfX Try-On is not connected yet.' %}
{% endcase %}
{% assign selfx_button_label = block.settings.button_label | default: selfx_default_button_label %}
{% assign selfx_helper_text = block.settings.helper_text | default: selfx_default_helper_text %}

<div class="selfx-tryon-block">
  <button
    type="button"
    class="selfx-tryon-button"
    data-selfx-launch-url="{{ selfx_launch_url }}"
    data-selfx-shop="{{ shop.permanent_domain }}"
    data-selfx-product-id="{{ product.id }}"
    data-selfx-product-handle="{{ product.handle }}"
    data-selfx-alert="{{ selfx_default_alert | escape }}"
  >
    {{ selfx_button_label }}
  </button>

  {% if selfx_helper_text != blank %}
    <p class="selfx-tryon-helper">
      {{ selfx_helper_text }}
    </p>
  {% endif %}
</div>

<style>
  .selfx-tryon-block {
    margin: 16px 0;
  }

  .selfx-tryon-button {
    width: 100%;
    border: 0;
    border-radius: 10px;
    padding: 14px 18px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }

  .selfx-tryon-button:hover {
    opacity: 0.92;
  }

  .selfx-tryon-helper {
    margin: 8px 0 0;
    font-size: 13px;
    color: #666;
  }
</style>

<script>
  document.addEventListener("click", function (event) {
    var button = event.target.closest(".selfx-tryon-button");
    if (!button) return;

    var launchUrl = button.dataset.selfxLaunchUrl;
    if (!launchUrl) {
      alert(button.dataset.selfxAlert || "SelfX Try-On is not connected yet.");
      return;
    }

    var url = new URL(launchUrl, window.location.origin);
    url.searchParams.set("shop", button.dataset.selfxShop);
    url.searchParams.set("productId", button.dataset.selfxProductId);
    url.searchParams.set("productHandle", button.dataset.selfxProductHandle);

    window.open(url.toString(), "_blank", "noopener,noreferrer");
  });
</script>

{% schema %}
{
  "name": "SelfX Try It On",
  "target": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "select",
      "id": "button_language",
      "label": "Language",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto storefront language" },
        { "value": "en", "label": "English" },
        { "value": "es", "label": "Spanish" },
        { "value": "ar", "label": "Arabic" },
        { "value": "hi", "label": "Hindi" },
        { "value": "fr", "label": "French" },
        { "value": "de", "label": "German" },
        { "value": "pt", "label": "Portuguese" },
        { "value": "it", "label": "Italian" }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Custom button label",
      "default": ""
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Custom helper text",
      "default": ""
    },
    {
      "type": "url",
      "id": "selfx_launch_url",
      "label": "SelfX launch URL"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ff6a00"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
